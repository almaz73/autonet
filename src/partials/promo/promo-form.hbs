<!--/* раньше это было в rightPanel */-->

<div class="promo-detail-call__wrap">
    <div class="div">
        <h3>Закажите обратный звонок</h3>

        <p class="pp">Просто оставьте свои контактные данные и мы сами вам перезвоним!</p>
    </div>


    <div class="div promo-form">
        <div class="formBlock">
            <div class="form__modal--group">
                <div class="form__group">
                    <input name="name" required placeholder="Ваше имя *">
                </div>
            </div>
            <div class='form__modal--group'>
                <div class='form__group'>
                    <input name='phone' required placeholder='Ваш телефон *' oninput='formattingPhone(this)'>
                </div>
            </div>
            <div class='form__modal--group'>
                <div class='form__group'>
                    <input name='email' required type='email' placeholder='E-mail'
                           onchange='emailValidate(this.value)'>
                </div>
            </div>

            <div class="form__modal--group">
                <div class="capctha-div"></div>
            </div>

            <button class="page__btn page__btn--current" onclick="sendBidPromo()">
                <span> Отправить заявку </span>
            </button>

            <div class="modal__personal">
                <input type="checkbox" id="dd1d">
                <label for="dd1d"> Нажав кнопку «Отправить заявку» я даю согласие на обработку
                    персональных <a href="/privacy-policy/" target="_blank">данных</a>
                </label>
            </div>

            <div class="modal__personal">
                <input type="checkbox" id="d2d1d" name="agree">
                <label for="d2d1d" style="cursor: pointer">
                    Согласие на рекламную <a href="/privacy-policy/agreement.html" target="_blank">коммуникацию</a>
                </label>
            </div>
        </div>
    </div>

</div>