<div class='container'>
    <div class="car_vitrina">
        <div class="car_vitrina">
            <h1 id="vitrina_name">Свежие поступления авто с пробегом</h1>

            <a href="/cars" class="page__link cars_link" >
                <img src="/st/red_arrow.svg" loading='lazy' alt=''>
                <span>Все предложения</span>
            </a>
        </div>
    </div>

    <div class="vitrina_tabs" role="tablist" aria-label="Подборки автомобилей на главной">
        <button type="button" class="vitrina_tab" role="tab" id="vitrina_tab_specials"
                aria-selected="false" aria-controls="main_vitrina_cards" tabindex="-1"
                data-tab="specials">Спецпредложения</button>
        <button type="button" class="vitrina_tab active" role="tab" id="vitrina_tab_latest"
                aria-selected="true" aria-controls="main_vitrina_cards" tabindex="0"
                data-tab="latest">Свежие поступления</button>
    </div>

    <cards id="main_vitrina_cards" class='cards dot4' data-col='dot4' role="tabpanel"
           aria-labelledby="vitrina_tab_latest"></cards>


</div>